# ========================================================
# JAI KISAN VYAPAR - SERVER ENVIRONMENT CONFIGURATION
# ========================================================

# MongoDB Database Connection
# Local MongoDB:   mongodb://127.0.0.1:27017/jai_kisan_agro
# Cloud (Atlas):   mongodb+srv://<username>:<password>@cluster0.mongodb.net/jai_kisan_agro
MONGO_URI=mongodb://127.0.0.1:27017/jai_kisan_agro

# Express Server Port
PORT=5000

# ========================================================
# GOVERNMENT NIC E-WAY BILL PORTAL API CONFIGURATION
# ========================================================
# Documentation & Portal: https://ewaybillgst.gov.in/
# Sandbox Testing: https://ewaybill1.nic.in/BillGeneration/BillUnderSandbox/EwbUserRegistration.aspx

# Your Registered 15-digit GSTIN
EWB_GSTIN=06AAACJ1234K1Z5

# NIC Portal API Username & Password (Created under 'Registration > For GSP / API' on NIC Portal)
EWB_USERNAME=your_nic_api_username
EWB_PASSWORD=your_nic_api_password

# API Mode: 'sandbox' (testing with auto-mock fallback) or 'production' (live NIC portal)
EWB_MODE=sandbox

# NIC Portal Endpoints
EWB_SANDBOX_URL=https://ewaybillgst.gov.in/BillGeneration
EWB_PRODUCTION_URL=https://ewaybillgst.gov.in/BillGeneration

# NIC E-Way Bill Schema Version
EWB_API_VERSION=1.0.0421
